APP_NAME=DataNarasi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (Catatan: DATABASE_URL akan diset otomatis oleh Railway)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=data_narasi
DB_USERNAME=root
DB_PASSWORD=

# Queue — database tidak butuh Redis, aman untuk shared hosting cPanel
QUEUE_CONNECTION=database

# Redis (opsional — hanya jika hosting menyediakannya)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & session (file aman untuk shared hosting)
CACHE_STORE=file
SESSION_DRIVER=file

# Storage
FILESYSTEM_DISK=local
MAX_UPLOAD_SIZE_MB=10

# ============================================
# AI PROVIDERS — isi key yang kamu punya
# Kosongkan yang belum ada, sistem akan skip
# ============================================

# Prioritas 1: LimitRouter (default utama)
# Base URL: https://limitrouter.com/v1
# Model default: deepseek-v4.1-flash
# Daftar model bisa dicek langsung dari panel admin (tombol "Ambil dari provider")
LIMITROUTER_API_KEY=

# Prioritas 2: Gemini (Google)
# Daftar di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Prioritas 3: Kimi API (Moonshot AI)
# Daftar di: https://platform.moonshot.cn/
KIMI_API_KEY=

# Prioritas 4: GLM (Zhipu AI)
# Daftar di: https://open.bigmodel.cn/
GLM_API_KEY=

# Prioritas 5: NVIDIA NIM (Free, 40 RPM)
# Daftar di: https://build.nvidia.com/ → Generate API Key
# Model default: nvidia/nemotron-3.5-lightning-30b-a3b
# Docs: https://docs.api.nvidia.com/nim/reference/
NVIDIA_API_KEY=

# Prioritas 5: MiniMax (OpenAI Compatible)
# Daftar di: https://platform.minimax.io/
# Model default: MiniMax-M2.5
# API key prefix: sk-cp- (Coding Plan) atau sk-api- (Standard)
MINIMAX_API_KEY=

# Prioritas 6: Claude (Anthropic) — aktifkan saat sudah subscribe
# Daftar di: https://console.anthropic.com/
CLAUDE_API_KEY=

# Prioritas 7: OpenRouter (300+ models via unified API)
# Daftar di: https://openrouter.ai/settings/keys
# Model default: google/gemini-2.5-flash (Free)
# Lihat semua model: https://openrouter.ai/models
OPENROUTER_API_KEY=

# Urutan fallback — provider yang API key-nya kosong dilewati otomatis
AI_PROVIDER_ORDER=limitrouter,gemini,kimi,glm,nvidia,minimax,claude,openrouter,tokenrouter

# Batas waktu per request AI (detik). Free tier bisa lambat — jangan < 60.
AI_REQUEST_TIMEOUT=120
AI_REQUEST_LONG_TIMEOUT=180
AI_MAX_TOKENS=2048

# Mail (opsional untuk notifikasi)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@datanarasai.app
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# Akun admin awal (dibuat oleh php artisan db:seed)
# GANTI password sebelum produksi!
# ============================================
ADMIN_NAME=Admin
ADMIN_EMAIL=admin17@gmail.com
ADMIN_PASSWORD=
