# Root .htaccess — dipakai karena document root menunjuk ke ROOT APLIKASI,
# bukan ke folder public/.
#
# Pola ini lebih rentan daripada mengarahkan docroot ke .../public: .env,
# vendor/, dan storage/ berada di dalam webroot. Urutan aturan di bawah ini
# yang menahan akses, dan sudah diuji terhadap lima kasus:
#
#   /upload                    → front controller          (200)
#   /build/assets/app.js       → public/build/assets/...   (200, aset Vite)
#   /storage/charts/1.png      → route storage.local       (200, chart PNG)
#   /storage/logs/laravel.log  → 403                       (log TIDAK bocor)
#   /storage/app/private/...   → 403                       (upload TIDAK bocor)
#   /PROMPT.md, /artisan, /.env → 403
#
# Kunci idempotensinya: syarat alias memakai %{REQUEST_FILENAME} (path saat
# ini), BUKAN %{REQUEST_URI}. Syarat berbasis REQUEST_URI akan cocok lagi
# pada pass kedua sehingga "public/" terpasang dua kali.
#
# Chart sengaja dilayani route Laravel (disk "public", visibility public),
# jadi TIDAK bergantung pada symlink public/storage. Symlink tetap boleh
# dibuat, hasilnya sama.
#
# Jangan menaruh berkas ini di dalam public/.

Options -Indexes

# ── Batas PHP untuk LiteSpeed/EA4 ────────────────────────────────────────
# Server target memakai LiteSpeed (sapi=litespeed, terverifikasi via
# ini_get di produksi). Pada LSAPI berkas .user.ini TIDAK dibaca — hanya
# php_value/php_flag di .htaccess yang berpengaruh. Terbukti: sebelum blok
# ini dipasang, upload_max_filesize tetap "2M" dan memory_limit "128M"
# meskipun .user.ini sudah berisi 12M/512M.
#
# Urutan yang benar: MAX_UPLOAD_SIZE_MB (.env, 10) < upload_max_filesize (12)
# < post_max_size (14). Kalau terbalik, unggahan ditolak PHP lebih dulu dan
# pengguna tidak melihat pesan apa pun — hanya halaman kosong.
<IfModule lsapi_module>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag log_errors On
    php_value error_log "/home/USER/logs/php.error.log"
</IfModule>
<IfModule php_module>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── 1. Alias ke public/ untuk path yang tidak ada di akar ────────────
    # Menangani aset Vite: URL /build/assets/app.js → public/build/assets/app.js
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # ── 2. Chart PNG: satu-satunya bagian storage/ yang boleh publik ─────
    # Aturan ini WAJIB di atas larangan storage/ di poin 5, dan TIDAK boleh
    # memakai syarat "!-d" seperti poin 1: folder storage/ memang ada di
    # docroot, jadi syarat itu akan selalu gagal dan chart berakhir 403.
    # URL publiknya /storage/charts/... → public/storage/charts/... (symlink).
    RewriteRule ^storage/charts/(.+)$ public/storage/charts/$1 [L]

    # ── 3. TOLAK berkas sensitif di akar aplikasi ────────────────────────
    # .env memuat seluruh API key dan password database.
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.env\. - [F,L]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^\.(htaccess|gitattributes|editorconfig|gitignore)$ - [F,L,NC]
    RewriteRule ^artisan$ - [F,L,NC]

    # Berkas akar berkedalaman satu dengan ekstensi ini tidak pernah publik:
    # README/CHANGELOG/PROMPT.md, composer.json/lock, package.json/lock,
    # phpunit.xml, *.bat, *.mjs, dan seterusnya. Pola [^/]+ sengaja hanya
    # cocok untuk berkas akar, jadi aset di dalam public/ tidak terkena.
    RewriteRule ^[^/]+\.(md|json|lock|xml|yml|yaml|neon|dist|bat|sh|txt|csv|mjs|ts|php)$ - [F,L,NC]

    # ── 4. TOLAK folder internal Laravel ─────────────────────────────────
    RewriteRule ^(app|bootstrap|config|database|deploy|resources|routes|tests|vendor|node_modules|python-service)(/|$) - [F,L]

    # ── 5. TOLAK seluruh isi storage/ lainnya ────────────────────────────
    # Yang ditahan di sini: log, session, cache, dan upload mentah pengguna
    # di storage/app/private. Chart sudah dialihkan aturan poin 2.
    RewriteRule ^storage(/|$) - [F,L]

    # ── 6. Sisanya masuk ke front controller Laravel ─────────────────────
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ public/index.php [L]
</IfModule>

# Lapis kedua bila mod_rewrite tidak aktif: tolak lewat FilesMatch.
<FilesMatch "^\.env|^\.git|^composer\.(json|lock)$|^artisan$">
    Require all denied
</FilesMatch>
